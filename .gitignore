# Python virtual environments
.venv/
venv/
ENV/
env/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# DVC internal cache, config & lock files
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Ignore ALL data contents except .dvc files and json metadata
data/*
!data/*.dvc
!data/book_authors.json

# Local logs & traces
data/production_audit_logs.jsonl
*.log

# Environment secret files
.env
.env.*
*.env

# OS generated files
.DS_Store
Thumbs.db

# Evaluation run output
evaluation/results/*
!evaluation/results/*.json
evaluation/results/latest.json
